# Submit a trajectory point to the continuous motion queue (streaming).
#
# Unlike queue_traj_point (which accepts at most one outstanding point),
# this service pushes into a multi-point FIFO and reports queue depth and
# whether an underrun occurred since the previous call to this service.
#
# The start_point_queue_mode service must have been invoked first

string[] joint_names
trajectory_msgs/JointTrajectoryPoint point

# Monotonic modulo-16-bit submission sequence. The first current-position
# baseline after start_point_queue_mode establishes the starting value.
uint16 sequence

---
# Result of the service invocation. Values other than one (1) signal failure.
# Refer to QueueResultEnum.msg for defined values
QueueResultEnum result_code

# string representation of the value in 'result_code', for humans
string message

# number of points currently queued (after this call)
uint16 queue_size

# TRUE if the point queue ran empty (underran) at any time since the
# previous call to THIS service; read-and-cleared by this call. The first
# call after startup is expected to report TRUE (baseline).
bool underran_since_last_call

# Echoed sequence state for retry/recovery diagnostics.
uint16 sequence
uint16 next_expected_sequence
bool duplicate_acknowledged
